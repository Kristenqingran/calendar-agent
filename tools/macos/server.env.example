# Copy to ~/.config/calendar-agent/server.env and chmod 600.
# Keep loopback for local development.
AGENT_SERVER_HOST=127.0.0.1
AGENT_SERVER_PORT=8000

# Required for the Mac-first real Calendar execution path. Point to the
# executable inside the built MacAgentHost.app bundle.
# MAC_AGENT_HOST_EXECUTABLE=/absolute/path/to/MacAgentHost.app/Contents/MacOS/MacAgentHost

# Required when AGENT_SERVER_HOST is non-loopback (for example 0.0.0.0).
# Generate and store locally; do not commit the real value.
# AGENT_API_TOKEN=replace-with-a-local-secret

# Optional; default is 65536 bytes.
# AGENT_MAX_REQUEST_BYTES=65536

# Remote access uses a separately managed Cloudflare Named Tunnel. Keep tunnel
# credentials in ~/.cloudflared/config.yml, never in this file.
# CLOUDFLARED_CONFIG=$HOME/.cloudflared/config.yml
# CLOUDFLARED_TUNNEL_NAME=calendar-agent
# Alternatively, a provider-issued token may be stored in
# ~/.config/calendar-agent/cloudflared-token with mode 600.
