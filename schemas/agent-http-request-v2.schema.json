{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://calendar-agent.local/schemas/agent-http-request-v2.schema.json",
  "title": "Calendar Agent V2 HTTP User Request",
  "description": "External user-turn envelope. request_id is optional and generated by the server when absent. conversation_id is reused to continue a conversation; task and step IDs remain server-owned.",
  "type": "object",
  "required": ["user_request"],
  "properties": {
    "request_id": {"$ref": "common-v2.schema.json#/$defs/id"},
    "conversation_id": {"$ref": "common-v2.schema.json#/$defs/id"},
    "user_request": {"type": "string", "minLength": 1},
    "assistant_timezone": {"$ref": "common-v2.schema.json#/$defs/iana_timezone"},
    "device_timezone": {"$ref": "common-v2.schema.json#/$defs/iana_timezone"}
  },
  "allOf": [
    {"if": {"required": ["request_id"]}, "then": {"required": ["conversation_id"]}}
  ],
  "additionalProperties": false
}
